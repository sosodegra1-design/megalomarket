# Copie ce fichier en ".env" et remplis tes vraies valeurs.
# Ne commite jamais le fichier ".env" lui-même (déjà exclu par .gitignore).

# Port du serveur (Render le fournit automatiquement en production)
PORT=3000

# Clé API Anthropic (Claude) — pour le moteur de recommandations IA
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- eBay (Sell API) ---
# https://developer.ebay.com/my/keys
EBAY_ENV=production
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_REFRESH_TOKEN=

# --- Site propre (Megalomarket) ---
# URL de base de l'API de ton site et clé pour l'authentifier
OWN_SITE_API_URL=
OWN_SITE_API_KEY=

# --- Amazon (en attente d'approbation SP-API) ---
AMAZON_REFRESH_TOKEN=
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_SELLER_ID=

# --- TikTok Shop (en attente d'approbation Partner API) ---
TIKTOKSHOP_APP_KEY=
TIKTOKSHOP_APP_SECRET=
TIKTOKSHOP_ACCESS_TOKEN=
TIKTOKSHOP_SHOP_ID=

# --- Base de données ---
# En local, laisse vide : une base SQLite locale est créée automatiquement (DATABASE_PATH).
# En production (Render), crée une base gratuite sur https://turso.tech et renseigne ces deux valeurs
# (visibles dans le dashboard Turso après `turso db create` puis `turso db tokens create`).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DATABASE_PATH=./data/megalomarket.db
