# Copie ce fichier en ".env" et remplis tes vraies valeurs.
# Ne commite jamais le fichier ".env" lui-même (déjà exclu par .gitignore).

# Port du serveur (Render le fournit automatiquement en production)
PORT=3000

# ============================================================================
# FOURNISSEUR IA — deux chemins possibles, un seul actif à la fois
# ============================================================================
#
# Pourquoi c'est configurable : le moteur IA (import, prix, descriptions,
# support) était branché sur un seul fournisseur. Un changement de prix, un
# modèle retiré ou un compte sans crédit faisait alors tomber TOUTES les
# fonctions IA d'un coup. Or Groq, Cerebras, OpenRouter, Gemini et Ollama
# exposent tous la même API « compatible OpenAI » (/chat/completions) : un seul
# adaptateur les couvre, donc changer de fournisseur ne demande aucune
# modification de code.
#
# AI_PROVIDER est FACULTATIF. Sans lui :
#   - ANTHROPIC_API_KEY présente            -> fournisseur « anthropic »
#   - sinon AI_BASE_URL + AI_API_KEY        -> fournisseur « openai »
# Une valeur explicite (anthropic | openai) gagne toujours.

# ----------------------------------------------------------------------------
# Chemin A — Anthropic (Claude), payant
# ----------------------------------------------------------------------------
# Clé API Anthropic : https://console.anthropic.com/settings/keys
# Attention : une clé ne suffit pas, le compte doit avoir du crédit, sinon
# chaque appel échoue. 5 $ couvrent largement les essais (quelques centimes
# par import : deux appels par produit, un pour les marketplaces et un pour
# le site).
ANTHROPIC_API_KEY=

# Modèle Anthropic utilisé quand le fournisseur est « anthropic ». Facultatif
# (défaut : claude-sonnet-5). Anthropic retire régulièrement d'anciens modèles,
# et un modèle retiré fait échouer TOUS les appels IA : en cas de retrait,
# change cette variable plutôt que le code.
# https://platform.claude.com/docs/en/about-claude/model-deprecations
ANTHROPIC_MODEL=claude-sonnet-5

# ----------------------------------------------------------------------------
# Chemin B — tout fournisseur « compatible OpenAI », dont les paliers gratuits
# ----------------------------------------------------------------------------
# AI_PROVIDER=openai      (facultatif : déduit automatiquement si AI_BASE_URL
#                          et AI_API_KEY sont renseignées)
# AI_BASE_URL=            base de l'API, SANS « /chat/completions »
# AI_API_KEY=             clé du fournisseur choisi
# AI_MODEL=               OBLIGATOIRE sur ce chemin : il n'existe aucun nom de
#                         modèle commun à tous ces fournisseurs, donc aucun
#                         défaut possible. Le nom exact se lit dans la console
#                         du fournisseur.
#
# Bases vérifiées aujourd'hui — les paliers gratuits changent souvent leurs
# limites, revérifie-les avant de t'appuyer dessus :
#
#   Groq            https://api.groq.com/openai/v1
#       Palier gratuit permanent, sans carte bancaire, ~1 000 requêtes/jour, et
#       ne s'entraîne PAS sur tes données. MEILLEUR CHOIX GRATUIT PAR DÉFAUT.
#
#   Cerebras        https://api.cerebras.ai/v1
#       Palier gratuit permanent, sans carte, environ 1 M de jetons/jour, ne
#       s'entraîne pas sur tes données.
#
#   OpenRouter      https://openrouter.ai/api/v1
#       20+ modèles gratuits avec une seule clé, sans carte, ne s'entraîne pas
#       sur tes données, mais le palier gratuit ne permet qu'~50 requêtes/jour.
#
#   Google Gemini   https://generativelanguage.googleapis.com/v1beta/openai/
#       Allocation gratuite de jetons généreuse, MAIS sur le palier gratuit
#       Google utilise ton contenu pour améliorer ses produits. ATTENTION :
#       l'agent de support traite des MESSAGES CLIENTS (données personnelles) —
#       un palier qui s'entraîne sur les données est un vrai problème RGPD/vie
#       privée. N'utilise PAS le palier gratuit Gemini pour cette fonction. Le
#       palier payant, lui, ne s'entraîne pas sur ton contenu.
#
#   Ollama local    http://localhost:11434/v1
#       Gratuit et confidentialité maximale, mais ne fonctionne PAS quand le hub
#       tourne sur une plateforme d'hébergement : uniquement en local.
#
# IMPORTANT : un plafond journalier atteint fait s'arrêter la fonction IA
# jusqu'au lendemain (et un plafond par minute jusqu'à la minute suivante).
# Prévois un fournisseur de secours ou attends la fenêtre suivante.
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Clé partagée protégeant TOUT le service : API, module d'import et tableau de
# bord. Seul /api/health reste public (surveillance).
# Si elle est absente, le service répond 503 partout — échec en fermé — au lieu
# de s'ouvrir à Internet.
# Trois façons de la présenter :
#   - en-tête  X-Admin-Key: <clé>            (scripts, curl)
#   - en-tête  Authorization: Bearer <clé>   (idem)
#   - HTTP Basic, mot de passe = la clé      (navigateur, pour le tableau de bord)
# Génère-la avec : openssl rand -hex 32
ADMIN_API_KEY=

# --- eBay (Sell API) ---
# https://developer.ebay.com/my/keys
EBAY_ENV=production
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_REFRESH_TOKEN=

# --- Site propre (Megalomarket) ---
# URL de base de l'API de ton site et clé pour l'authentifier
OWN_SITE_API_URL=
OWN_SITE_API_KEY=

# --- Amazon (en attente d'approbation SP-API) ---
AMAZON_REFRESH_TOKEN=
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_SELLER_ID=

# --- TikTok Shop (en attente d'approbation Partner API) ---
TIKTOKSHOP_APP_KEY=
TIKTOKSHOP_APP_SECRET=
TIKTOKSHOP_ACCESS_TOKEN=
TIKTOKSHOP_SHOP_ID=

# --- Allegro (en attente d'inscription développeur) ---
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
ALLEGRO_REFRESH_TOKEN=

# --- Optionnel eBay : requis par certains comptes pour publier une nouvelle fiche produit ---
EBAY_MERCHANT_LOCATION_KEY=

# --- Import produit par lien : calcul du prix de vente conseillé ---
# prix conseillé = prix d'achat * PRICING_MARGIN_COEFFICIENT + PRICING_FIXED_FEE
# (jamais en dessous de prix d'achat + PRICING_FIXED_FEE, quel que soit le coefficient)
PRICING_MARGIN_COEFFICIENT=1.8
PRICING_FIXED_FEE=0

# --- Base de données ---
# En local, laisse vide : une base SQLite locale est créée automatiquement (DATABASE_PATH).
# En production (Render), crée une base gratuite sur https://turso.tech et renseigne ces deux valeurs
# (visibles dans le dashboard Turso après `turso db create` puis `turso db tokens create`).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DATABASE_PATH=./data/megalomarket.db
