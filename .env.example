AI_API_KEY=ollama
AI_MODEL=qwen3:8b
AI_VISION_MODEL=llama3.2-vision
AI_TIMEOUT_MS=300000

# --- Sourcing automatique (Favoris Chrome) ---
BOOKMARKS_FOLDER=Barre de favoris
MEGALOMARKET_URL=http://localhost:3000
WATCH_INTERVAL_MINUTES=5

# Clé qui protège le tableau de bord (mot de passe du navigateur)
ADMIN_API_KEY=58872b85b9769b6e89c25ad93a0216bee5efda0265381c5718a84ad4164f6fba

# Site propre
OWN_SITE_API_URL=
OWN_SITE_API_KEY=

# Amazon
AMAZON_REFRESH_TOKEN=
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
