{
  "name": "megalomarket-ai-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Megalomarket AI Core — moteur de recommandations et de synchronisation omnicanale (LumiVita, site propre, Amazon, TikTok Shop, Allegro).",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "verify:turso": "node scripts/verify-turso.mjs",
    "verify:ollama": "node scripts/verify-ollama.mjs",
    "watch:bookmarks": "node scripts/watch-bookmarks.mjs",
    "autostart:install": "node scripts/install-autostart.mjs",
    "autostart:uninstall": "node scripts/install-autostart.mjs --uninstall",
    "doctor": "node scripts/doctor.mjs",
    "report": "node scripts/report.mjs",
    "report:push": "node scripts/report.mjs --push",
    "restart": "launchctl kickstart -k gui/$(id -u)/com.megalomarket.server && launchctl kickstart -k gui/$(id -u)/com.megalomarket.watcher",
    "logs": "tail -n 40 -f ~/Library/Logs/Megalomarket/com.megalomarket.server.log ~/Library/Logs/Megalomarket/com.megalomarket.server.err.log ~/Library/Logs/Megalomarket/com.megalomarket.watcher.log",
    "status": "launchctl list | grep megalomarket || echo \"Aucun agent Megalomarket chargé (npm run autostart:install)\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@libsql/client": "^0.14.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-cron": "^4.6.0"
  }
}
